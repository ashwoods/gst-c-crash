#!/bin/sh
#
# Check that the code follows GStreamer's code style, with gst-indent
# (https://gitlab.freedesktop.org/gstreamer/gst-indent), which applies it by
# default: the venv's from `just setup` first, then the one on PATH.

INDENT="`git rev-parse --show-toplevel`/.venv/bin/gst-indent-1.0"
if [ ! -x "$INDENT" ]; then
  INDENT=`command -v gst-indent-1.0`
  if [ -z "$INDENT" ]; then
    echo "GStreamer git pre-commit hook:"
    echo "Did not find gst-indent-1.0. Install it with \`just setup\`, which puts it"
    echo "in .venv, or with \`pip install gst-indent==1.0.0\`, then commit again."
    exit 1
  fi
fi

echo "--Checking style--"
for file in `git diff-index --cached --name-only HEAD --diff-filter=ACMR| grep "\.c$"` ; do
    # nf is the temporary checkout. This makes sure we check against the
    # revision in the index (and not the checked out version).
    nf=`git checkout-index --temp ${file} | cut -f 1`
    # Call indent twice as it tends to do line-breaks different for every
    # second call. Read stdin and write stdout: given a file, gst-indent
    # leaves a file~ backup beside it.
    "$INDENT" -st < "${nf}" 2>> /dev/null | "$INDENT" -st 2>> /dev/null | \
        diff -u -p -L "${file}" -L "${file} (gst-indent)" "${nf}" -
    r=$?
    rm "${nf}"
    if [ $r != 0 ] ; then
echo "================================================================================================="
echo " Code style error in: $file                                                                      "
echo "                                                                                                 "
echo " Please fix before committing. Don't forget to run git add before trying to commit again.        "
echo " If the whole file is to be committed, this should work (run from the top-level directory):      "
echo "                                                                                                 "
echo "   just fix-indent $file; git add $file; git commit"
echo "                                                                                                 "
echo "================================================================================================="
        exit 1
    fi
done
echo "--Checking style pass--"
