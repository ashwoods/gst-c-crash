{
  "extensions": {
    "disable": [
      "update"
    ]
  },
  "isolates": {
    "worktree": {
      "setup": ["sh -e .ultimate/worktree-setup.sh"]
    }
  },
  "lander": {
    "checks": [
      "just indent",
      "ninja -C build",
      {
        "command": "GST_PLUGIN_PATH=$PWD/build/gst .venv/bin/pytest -q -p no:cacheprovider tests",
        "timeout": 300
      }
    ]
  }
}
